# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SportShield — Environment Configuration
# Copy this file to .env and fill in your values
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Application
APP_NAME=SportShield
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite for local dev, change for production)
DATABASE_URL=sqlite:///./sportshield.db

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=sportshield-super-secret-change-in-production-min-32-chars
JWT_SECRET=jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# Google Gemini API (optional — enhances AI analysis)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Redis (optional — for background job queuing)
REDIS_URL=redis://localhost:6379/0

# CORS — Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
