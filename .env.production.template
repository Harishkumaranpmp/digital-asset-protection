# ==============================================================
# SportShield — Production Environment Variables Template
# Copy this to .env.production and fill in your values.
# NEVER commit .env.production to version control.
# ==============================================================

# ── Application ───────────────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_VERSION=1.0.0

# ── Security (GENERATE STRONG SECRETS) ───────────────────────
# Run: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_64_CHARS
JWT_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=sportshield
POSTGRES_USER=sportshield
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# For Cloud SQL via proxy: postgresql+psycopg2://user:pass@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=postgresql+psycopg2://sportshield:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/sportshield

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# For Upstash: rediss://default:TOKEN@endpoint:6379
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=500

# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
CLOUD_STORAGE_BUCKET=sportshield-media-bucket
# Path to service account key JSON (or use Workload Identity)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Sentry Error Tracking ─────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456

# ── SMTP (Legal Enforcement Emails) ──────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=legal@yourdomain.com
SMTP_PASSWORD=your-app-specific-password
SENDER_EMAIL=legal@yourdomain.com

# ── CORS (Frontend Domain) ────────────────────────────────────
# Add your Vercel URL and custom domain
ALLOWED_ORIGINS=["https://sportshield.vercel.app","https://yourdomain.com"]

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
